# ---------------------------------------------------------------- application
APP_NAME=AI Image Generator
API_HOST=0.0.0.0
API_PORT=8200
CORS_ORIGINS=*

# Where jobs, images, ZIPs and the SQLite file live.
DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   # SQLite is used when unset

# ------------------------------------------------------------------ generator
# mock         - placeholder images, no GPU or model needed (local dev, CI)
# runware      - hosted pay-per-image API, ~$0.0006/image, no infrastructure
# pollinations - free hosted API, no key; rate limited and watermarked
# comfyui      - self-hosted ComfyUI server running the workflow below
GENERATOR_BACKEND=mock
GENERATION_CONCURRENCY=1

# Hosted APIs are rate limited; retry a few times with backoff between attempts.
PROMPT_MAX_ATTEMPTS=1
PROMPT_RETRY_BACKOFF_SECONDS=2

# --------------------------------------------------------- hosted image APIs
# Sign up at runware.ai; new accounts get free starter credits.
RUNWARE_API_KEY=
RUNWARE_MODEL=runware:100@1
RUNWARE_BASE_URL=https://api.runware.ai/v1

POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=flux

API_TIMEOUT_SECONDS=240

# Set to false to run the worker as its own process/container:
#   python -m app.workers.runner
RUN_WORKER_IN_API=true

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=comfyui/workflows/flux_schnell.json
COMFYUI_TIMEOUT_SECONDS=600

MOCK_DELAY_SECONDS=0.25
MOCK_FAILURE_RATE=0.0

# ------------------------------------------------------------- image defaults
DEFAULT_MODEL=FLUX.1-schnell
DEFAULT_WIDTH=1280
DEFAULT_HEIGHT=720
DEFAULT_STEPS=4
DEFAULT_BATCH_SIZE=1
DEFAULT_IMAGE_FORMAT=png

# ------------------------------------------------------------------ batching
MIN_PROMPTS=1
MAX_PROMPTS=100
RECOMMENDED_MIN_PROMPTS=50

# ------------------------------------------------------- retention & cleanup
ZIP_RETENTION_HOURS=10
CLEANUP_INTERVAL_SECONDS=300

# ---------------------------------------------------------- video rendering
# Requires ffmpeg on PATH (brew install ffmpeg / apt-get install ffmpeg)
FFMPEG_BINARY=ffmpeg
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_TIMEOUT_SECONDS=1800

# --------------------------------------------------------------- disk guard
# Sized for local FLUX output. Hosted-API PNGs at 1280x720 measure ~0.5 MB,
# so set this to 1 when using the runware/pollinations backends — otherwise
# the guard reserves ~10x more space than a batch actually needs.
ESTIMATED_IMAGE_MB=5
DISK_SAFETY_FACTOR=2.2
DISK_MIN_FREE_MB=1024

# ------------------------------------------------------------------ frontend
NEXT_PUBLIC_API_BASE=http://localhost:8200
