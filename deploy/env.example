# Copy to repo root as .env on the VM, fill in real keys, then chmod 600 .env
# (These are read by backend/app/config.py and scripts/build_premium.py)

# --- image + audio generation ---
GENERATOR_BACKEND=openai
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1536x1024

TTS_PROVIDER=sarvam
SARVAM_API_KEY=REPLACE_ME

# --- render tuning for c2d-standard-8 (8 vCPU / 32 GB) ---
REMOTION_CONCURRENCY=5

# --- housekeeping ---
ZIP_RETENTION_HOURS=24
